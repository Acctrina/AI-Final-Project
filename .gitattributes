# Normalize line endings: store as LF in the repo, check out native on each OS.
* text=auto

# Visual Studio files are written with CRLF by the IDE; keep them CRLF on checkout.
*.sln            text eol=crlf
*.vcxproj        text eol=crlf
*.vcxproj.filters text eol=crlf
*.vcxproj.user   text eol=crlf
*.props          text eol=crlf

# Source
*.c   text
*.cpp text
*.h   text
*.hpp text

# Binary assets and vendored libraries (never normalize these).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.wav  binary
*.dll  binary
*.lib  binary
*.exe  binary
*.pdb  binary
*.ipch binary
